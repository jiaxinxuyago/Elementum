{
  // AI Consultant proxy (INF_01 §4.3) — holds the LLM key, verifies the caller's
  // Supabase session + Advisor entitlement, enforces caps + the monthly budget
  // kill-switch, assembles the prompt (voice charter + chart payload), and
  // streams the model's reply back as SSE.
  // Deploy:  npx wrangler deploy --config workers/llm/wrangler.jsonc
  //
  // Secrets (wrangler secret put <NAME> --config <this file>):
  //   ANTHROPIC_API_KEY         — the model
  //   SUPABASE_SERVICE_ROLE_KEY — entitlement checks + usage writes
  "name": "elementum-llm",
  "main": "index.js",
  "compatibility_date": "2025-11-01",
  // Public .workers.dev URL is REQUIRED: the browser calls /chat directly
  // (AIConsultantScreen); access is enforced in-worker (JWT + entitlement).
  "workers_dev": true,
  // Version preview URLs (*-elementum-llm.<account>.workers.dev) retired —
  // one address per Worker (INF_01 §10.0, owner 2026-09-15).
  "preview_urls": false,
  "vars": {
    "SUPABASE_URL": "https://nbactbfxqslzehzbgetp.supabase.co",
    // The model switch (INF_01 §4.3): Sonnet for beta; flip to the open arm
    // (model id prefixed "workersai/") when the cost trigger fires.
    "MODEL": "claude-sonnet-5",
    // Phase 1, open to every Advisor (owner ruling L1 A, 2026-10-23, BIZ_05 §9):
    // 10 messages a day each, a $150 monthly safety limit; review at day 30.
    "DAILY_CAP": "10",
    "MONTHLY_BUDGET_USD": "150",
    // Comma-separated user ids to limit the consultant to; "" = every Advisor.
    // (The /legal AI Consultant section has been live since 2026-07.)
    "OWNER_IDS": ""
  }
}
