{
  // Serve the built Vite app (dist/) as a static-assets Worker — same
  // pattern as the portfolio site. Build with `npm run build`, deploy
  // with `npx wrangler deploy`.
  "name": "elementum",
  "compatibility_date": "2025-11-01",
  // ── CUSTOM DOMAIN — elementum.life is the sole canonical URL ──────────
  // Cloudflare serves the app on elementum.life (custom domain, auto HTTPS).
  // workers_dev:false retires the *.workers.dev URL, and preview_urls:false
  // retires version preview URLs — so elementum.life is the only public
  // address (cleaner branding, no duplicate-site indexing).
  "routes": [
    { "pattern": "elementum.life", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./dist",
    // The app is a single index.html (hash navigation, no client routes),
    // but SPA fallback keeps deep links and the SW navigation safe.
    "not_found_handling": "single-page-application"
  }
}
