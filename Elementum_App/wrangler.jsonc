{
  // Serve the built Vite app (dist/) as a static-assets Worker — same
  // pattern as the portfolio site. Build with `npm run build`, deploy
  // with `npx wrangler deploy`.
  "name": "elementum",
  "compatibility_date": "2025-11-01",
  // ── CUSTOM DOMAIN — elementum.life is the sole canonical URL ──────────
  // Cloudflare serves the app on elementum.life (custom domain, auto HTTPS).
  // The domain is attached to this Worker in the Cloudflare dashboard and is
  // deliberately NOT declared here: declaring it makes wrangler sync zone
  // routes on every deploy, which needs zone-level token permissions that
  // account-owned API tokens (used by the deploy workflow) cannot carry.
  // If the Worker is ever recreated from scratch, re-attach elementum.life
  // via dashboard → Workers → elementum → Settings → Domains & Routes.
  // workers_dev:false retires the *.workers.dev URL, and preview_urls:false
  // retires version preview URLs — so elementum.life is the only public
  // address (cleaner branding, no duplicate-site indexing).
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./dist",
    // The app is a single index.html (hash navigation, no client routes),
    // but SPA fallback keeps deep links and the SW navigation safe.
    "not_found_handling": "single-page-application"
  },

  // ── DEV / STAGING — the elementum-dev Worker (owner 2026-09-15) ────────
  // A second Worker serving a VITE_DEVTOOLS=1 build (DevBar + the
  // window.__seedData/__goto QA hooks) so cloud sessions get a live testing
  // surface. Deployed by .github/workflows/deploy-dev.yml on every push to
  // the `dev` branch (`wrangler deploy --env dev`). Its address is
  // https://dev.elementum.life — a custom domain attached in the dashboard
  // (Workers → elementum-dev → Settings → Domains & Routes) and, for the same
  // token-permission reason as elementum.life above, deliberately NOT
  // declared here. workers_dev:false retires the auto
  // elementum-dev.<account>.workers.dev URL so the dev site has one address
  // (owner 2026-09-15). The build is noindex (vite.config.js) — never a
  // public address. Full topology + workflow: INF_01 §10.
  "env": {
    "dev": {
      "name": "elementum-dev",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
