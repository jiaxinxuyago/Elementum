<!--
  ELEMENTUM · DESIGN RESOURCE POOL · TIER 2
  File: Design/assets/Moodboards/component-library.html
  Purpose: Lego component library for reusable Elementum UI building blocks, rendered at real size with copy-paste annotations.
  Sources composed from: tokens.css, icons.svg, Tier 1 mood-foundation.html, brush-samples PNGs, atmospheric-depth PNGs, Design/Legends/legend-v7-ink-wash.html.
  Date: 2026-05-06
  Constraint summary: structure → SVG; painterly → PNG; no new PNG generation; hard-token aligned.
-->
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=1280"/>
<title>Elementum · Component Library · Tier 2</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+SC:wght@400;500;600&display=swap" rel="stylesheet"/>
<style>
/* canonical tokens inlined from ../../tokens.css */
/* =============================================================
   Elementum · Design Tokens (canonical source-of-truth)
   =============================================================
   This file is the single canonical CSS-variable source for:
     · legend-primitives.html
     · legend-patterns.html
     · legend-screens.html
     · legend-screens-amendment.html
     · any future legend or prototype HTML
The same values are mirrored to:
     · Elementum_App/src/styles/tokens.jsx (JS-named exports)
When editing: update this file FIRST, then sync tokens.jsx.
   Drift between the two is a doc-patch trigger.
Sealed against:
     · northstar-anchor.html (T object, lines 67–104)
     · DOC5 §2 + §3 + §3.5 + §3.5.A pigment alpha ladder
   ============================================================= */
:root {
  /* ───── Paper · Silk · Ink ───── */
  --cream:     #F8F6F0;
  --silk:      #F1E9D6;
  --silkDeep:  #ECE2C9;
  --silkFold:  #DDD1B3;
  --parchment: #EAE5DF;
  --vellum:    #DDD8CC;
  --paperHair: #CDBE9E;
  --ink:       #2B2722;
  --inkSoft:   #4A433B;
  --inkLight:  #857D72;
  --inkMist:   #B8AFA1;
  --inkDeep:   #1a1815;
  /* ───── Bronze ramp ───── */
  --bronzeLight: #9d8468;
  --bronze:      #8b7355;
  --bronzeDark:  #6b5339;
  --walnut:      #5a4430;
  --gold:        #D4AF37;
  /* ───── Borders ───── */
  --borderStd:   #D5CDBD;
  --borderLight: #E5DFD1;
  --borderFocus: #8b7355;
  --dmBorder:    #584A3E;
  /* Day-master pillar highlight only — never used elsewhere */
/* ───── Five-element pigments + *Deep companions ─────
     Pigment alpha ladder (DOC5 §3.5.A — only these alphas allowed):
       ${
  pigment
}
10 → ~6%  · soft fill (card bg)
       ${
  pigment
}
1A → ~10% · tint fill (icon bg)
       ${
  pigment
}
40 → ~25% · border / chip outline
       ${
  pigment
}
CC → ~80% · eyebrow text (DOC5 §3 reading-page label)
       ${
  pigment
}
→ 100% · glyph / heading on tint
     ────────────────────────────────────────────────── */
  --metal:     #8ba3b8;
  --metalDeep: #6a849a;
  --wood:      #7a9e6e;
  --woodDeep:  #587a4d;
  --fire:      #c4745a;
  --fireDeep:  #9e5540;
  --earth:     #b89a6a;
  --earthDeep: #927750;
  --water:     #5a7fa8;
  --waterDeep: #3e5f85;
  /* ───── Reserved accents ───── */
  --seal:      #A04030;
  /* MAX ONCE PER SCREEN — chop mark only */
  --advisor:   #7a5e9a;
  /* Premium tier accent */
/* ───── Surface fills (DOC5 §3.5.D card surface taxonomy) ───── */
  --quiet-bg:      #EBE5D6;
  --quiet-border:  #DCD3C0;
  --cardstock-bg:  rgba(248, 241, 225, 0.92);
  --tabbar-bg:     rgba(253, 253, 252, 0.85);
  /* with backdrop-filter: blur(12px) */
/* ───── Spacing scale (DOC5 §3.5.C — only these values allowed) ───── */
  --sp-1:  1px;
  --sp-3:  3px;
  --sp-4:  4px;
  --sp-5:  5px;
  --sp-6:  6px;
  --sp-8:  8px;
  --sp-10: 10px;
  --sp-12: 12px;
  --sp-14: 14px;
  --sp-16: 16px;
  --sp-18: 18px;
  --sp-20: 20px;
  --sp-22: 22px;
  --sp-26: 26px;
  --sp-28: 28px;
  --sp-36: 36px;
  --sp-44: 44px;
  --sp-56: 56px;
  /* Forbidden values (DOC5 §3.5.C anti-pattern):
     7, 9, 11, 13, 15, 17, 19, 21, 24, 30, 32, 40, 48, 64 */
/* ───── Border-radius scale (DOC5 §3.5.B) ───── */
  --r-1:    1px;
  /* Segmented bar cells, hairline pills */
  --r-10:   10px;
  /* Small icon containers (36×36) */
  --r-12:   12px;
  /* Standard cards, list rows, 44×44 icons */
  --r-16:   16px;
  /* Feature cards, large stem seal (84×84) */
  --r-22:   22px;
  /* Toggle pills, archetype glyph backdrop */
  --r-pill: 999px;
  /* CTAs, chips, badges */
  /* Forbidden radii: 4, 6, 8, 14, 18, 20, 28
     Reserved (phone-frame only): 47px, 56px */
/* ───── Shadows ───── */
  --shadow-card:    0 1px 0 rgba(43, 39, 34, 0.04);
  /* cardstock lift line */
  --shadow-cta:     0 6px 18px rgba(40, 30, 20, 0.18);
  /* primary pill */
  --shadow-cta-alt: 0 8px 22px rgba(43, 39, 34, 0.35);
  /* CTA over imagery */
  --shadow-sheet:   0 -8px 40px rgba(0, 0, 0, 0.12);
  /* bottom-sheet upward */
  --shadow-bronze:  0 4px 12px rgba(107, 83, 57, 0.20);
  /* bronze pill */
  --shadow-phone:
    0 30px 60px rgba(40, 30, 20, 0.18),
    0 8px 18px rgba(40, 30, 20, 0.10),
    inset 0 0 0 8px var(--ink),
    inset 0 0 0 9px rgba(80, 72, 60, 0.4);
  /* ───── Easing curves (DOC5 §4) ───── */
  --ease-out:   cubic-bezier(0.22, 1, 0.36, 1);
  /* most screen entrances */
  --ease-inout: ease-in-out;
  /* progress bars */
  --d-fast:     150ms;
  --d-medium:   220ms;
  --d-slow:     400ms;
  --d-ceremony: 600ms;
}
* {
  box-sizing: border-box;
}
html, body {
  margin: 0;
  padding: 0;
}
body {
  font-family: 'EB Garamond', Georgia, serif;
  font-style: normal;
  color: var(--ink);
  background: #EFE5CC;
  background-image:
    radial-gradient(1100px 700px at 12% -10%, rgba(248,241,225,0.7), transparent 60%),
    radial-gradient(900px 600px at 90% 8%, rgba(241,233,214,0.6), transparent 60%);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
.page {
  max-width: 1180px;
  margin: 0 auto;
  padding: var(--sp-44) var(--sp-56) var(--sp-56);
}
.doc-header {
  border-bottom: 1px solid var(--paperHair);
  padding-bottom: var(--sp-28);
  margin-bottom: var(--sp-44);
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: end;
  gap: var(--sp-28);
}
.doc-header .cn {
  font-family: 'Noto Serif SC', serif;
  font-size: 28px;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 8px;
  margin-bottom: var(--sp-8);
}
.doc-header h1 {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 600;
  font-size: 44px;
  line-height: 1.05;
  color: var(--ink);
  margin: 0;
  letter-spacing: .5px;
}
.doc-header h1 .sub {
  display: block;
  color: var(--bronzeDark);
  font-size: 30px;
  font-weight: 500;
  margin-top: var(--sp-6);
}
.doc-header .subline {
  font-family:'Cormorant Garamond', serif;
  font-size:19px;
  line-height:1.3;
  font-weight:500;
  font-style:italic;
  color:var(--inkSoft);
  margin-top:var(--sp-10);
}
.doc-header .meta {
  text-align:right;
  font-size:12px;
  color:var(--inkLight);
  letter-spacing:.5px;
  line-height:1.7;
}
.doc-header .meta .cinzel {
  font-family:'Cinzel', serif;
  font-size:11px;
  letter-spacing:3px;
  color:var(--bronzeDark);
  text-transform:uppercase;
}
.seal-mark {
  color: var(--seal);
}
.toc {
  background: var(--cardstock-bg);
  border:1px solid var(--paperHair);
  border-radius: var(--r-22);
  padding: var(--sp-22) var(--sp-28);
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap: var(--sp-6) var(--sp-28);
  margin-bottom:var(--sp-44);
}
.toc h3 {
  grid-column:1/-1;
  font-family:'EB Garamond',serif;
  font-size:10px;
  font-weight:500;
  letter-spacing:2.5px;
  text-transform:uppercase;
  color:var(--bronzeDark);
  margin:0 0 var(--sp-10);
}
.toc a {
  display:flex;
  gap:var(--sp-14);
  align-items:baseline;
  font-size:14.5px;
  color:var(--inkSoft);
  text-decoration:none;
  padding:var(--sp-6) 0;
  border-bottom:1px dotted rgba(139,115,85,.18);
}
.toc a .num {
  font-family:'Cinzel',serif;
  font-size:10px;
  letter-spacing:2px;
  color:var(--bronze);
  flex:0 0 50px;
}
section {
  margin-bottom: var(--sp-56);
  scroll-margin-top:var(--sp-22);
}
.section-head {
  display:grid;
  grid-template-columns:auto 1fr;
  gap:var(--sp-18);
  align-items:end;
  margin-bottom:var(--sp-22);
  border-bottom:1px solid var(--paperHair);
  padding-bottom:var(--sp-14);
}
.section-head .num {
  font-family:'Cinzel',serif;
  font-size:14px;
  letter-spacing:3px;
  color:var(--bronzeDark);
  align-self:start;
  padding-top:var(--sp-8);
}
.section-head h2 {
  font-family:'Cormorant Garamond',serif;
  font-size:30px;
  font-weight:600;
  color:var(--ink);
  margin:0;
  letter-spacing:.4px;
}
.section-head .rule {
  font-family:'EB Garamond',serif;
  font-size:14px;
  color:var(--inkLight);
  margin-top:var(--sp-4);
}
.component-row {
  display:grid;
  grid-template-columns: minmax(360px, 420px) 1fr;
  gap:var(--sp-18);
  align-items:start;
  margin-bottom:var(--sp-18);
}
.card-row {
  grid-template-columns: minmax(360px, 760px) 1fr;
}
.component-live, .component-code, .button-cell, .thumb-cell {
  background:var(--cardstock-bg);
  border:1px solid var(--paperHair);
  border-radius:var(--r-16);
  box-shadow:var(--shadow-card);
  padding:var(--sp-18);
}
.component-kicker {
  font-family:'Cinzel',serif;
  font-size:10px;
  letter-spacing:2px;
  text-transform:uppercase;
  color:var(--bronzeDark);
  margin-bottom:var(--sp-14);
}
pre {
  margin:0;
  max-height:170px;
  overflow:auto;
  background:rgba(139,115,85,.08);
  border:1px solid var(--paperHair);
  border-radius:var(--r-10);
  padding:var(--sp-10);
  color:var(--inkSoft);
  font-family:'JetBrains Mono',ui-monospace,Menlo,monospace;
  font-size:10px;
  line-height:1.45;
}
code {
  font-family:'JetBrains Mono',ui-monospace,Menlo,monospace;
}
/* shared text recipes */
.tb h3, .tb p {
  margin:0;
}
.tb-hero h3 {
  font-family:'Cormorant Garamond',serif;
  font-size:38px;
  line-height:1.1;
  font-weight:400;
  color:var(--ink);
}
.tb-hero p, .subheadline, .tb-quote p, .tb-manifesto p {
  font-family:'Cormorant Garamond',serif;
  font-style:italic;
  color:var(--inkSoft);
}
.tb-hero p {
  font-size:19px;
  line-height:1.3;
  font-weight:500;
  margin-top:var(--sp-5);
}
.element-eyebrow, .eyebrow {
  display:block;
  font-family:'EB Garamond',serif;
  font-size:10px;
  font-weight:500;
  letter-spacing:2.5px;
  text-transform:uppercase;
  color:var(--bronze);
}
.eyebrow.metal {
  color:#8ba3b8CC;
}
.tb-section-headline h3 {
  font-family:'Cormorant Garamond',serif;
  font-size:24px;
  line-height:1.2;
  font-weight:600;
  margin:var(--sp-4) 0 0;
}
.tb-card-stack h3 {
  font-family:'Cormorant Garamond',serif;
  font-size:18px;
  line-height:1.2;
  font-weight:600;
  margin:var(--sp-5) 0;
}
.tb-card-stack p {
  font-family:'EB Garamond',serif;
  font-size:14px;
  line-height:1.55;
  font-weight:400;
  color:var(--inkSoft);
  max-width:300px;
}
.brush-rule {
  border:0;
  height:1px;
  background:linear-gradient(90deg,transparent,var(--paperHair),transparent);
  margin:0 0 var(--sp-14);
}
.tb-quote p {
  font-size:17px;
  line-height:1.45;
  font-weight:500;
}
.tb-data strong {
  display:block;
  font-family:'Cormorant Garamond',serif;
  font-size:38px;
  line-height:1;
  font-weight:600;
}
.tb-data span {
  display:block;
  font-family:'EB Garamond',serif;
  font-size:11px;
  line-height:1.2;
  font-weight:500;
  letter-spacing:2.5px;
  color:var(--bronzeDark);
  margin-top:var(--sp-5);
}
.tb-data p {
  font-family:'EB Garamond',serif;
  font-size:12.5px;
  line-height:1.45;
  color:var(--inkSoft);
  margin-top:var(--sp-8);
}
.microchips {
  display:flex;
  gap:var(--sp-8);
  flex-wrap:wrap;
}
.microchip {
  display:inline-flex;
  align-items:center;
  padding:var(--sp-5) var(--sp-12);
  font-family:'EB Garamond',serif;
  font-size:11.5px;
  line-height:1.4;
  font-style:italic;
  color:var(--inkLight);
  background:rgba(139,115,85,.08);
  border:1px solid var(--paperHair);
  border-radius:var(--r-pill);
}
.tb-chev-row {
  display:flex;
  align-items:center;
  justify-content:space-between;
  width:260px;
}
.tb-chev-row svg {
  width:18px;
  height:18px;
  color:var(--bronzeDark);
}
.tb-daystamp, .daystamp {
  display:flex;
  align-items:center;
  gap:var(--sp-8);
}
.tb-daystamp strong, .daystamp strong {
  font-family:'Noto Serif SC',serif;
  font-size:14px;
  font-weight:500;
  color:var(--metalDeep);
}
.tb-daystamp span, .daystamp span {
  font-family:'EB Garamond',serif;
  font-size:10px;
  line-height:1.2;
  letter-spacing:2.5px;
  color:#6a849aCC;
}
.tb-manifesto p {
  font-size:17px;
  line-height:1.45;
  font-weight:500;
  text-align:center;
}
.tb-status {
  display:flex;
  align-items:center;
  gap:var(--sp-8);
  font-family:'EB Garamond',serif;
  font-size:11.5px;
  color:var(--inkLight);
  font-variant-numeric:tabular-nums;
}
.tb-status strong {
  font-weight:500;
  color:var(--inkSoft);
}
/* buttons */
.button-grid {
  display:grid;
  grid-template-columns:repeat(5, minmax(0,1fr));
  gap:var(--sp-14);
}
.button-cell {
  min-height:230px;
}
.btn {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:44px;
  padding:0 var(--sp-22);
  border:0;
  cursor:default;
  white-space:nowrap;
  transition:transform var(--d-fast) var(--ease-out);
}
.btn-primary {
  background:var(--ink);
  color:var(--silk);
  font-family:'Cinzel',serif;
  font-size:12px;
  line-height:1;
  font-weight:500;
  letter-spacing:3.6px;
  text-transform:uppercase;
  border-radius:var(--r-pill);
  box-shadow:var(--shadow-cta);
}
.btn-secondary {
  background:var(--cardstock-bg);
  color:var(--ink);
  font-family:'Cinzel',serif;
  font-size:12px;
  line-height:1;
  font-weight:500;
  letter-spacing:3.6px;
  text-transform:uppercase;
  border:1px solid var(--paperHair);
  border-radius:var(--r-pill);
}
.btn-tertiary {
  min-height:28px;
  padding:0;
  background:transparent;
  color:var(--inkSoft);
  font-family:'EB Garamond',serif;
  font-size:13px;
  line-height:1;
  font-weight:500;
  border:0;
  border-bottom:1px dashed var(--paperHair);
  border-radius:0;
}
.btn-ghost {
  background:transparent;
  color:var(--ink);
  font-family:'Cinzel',serif;
  font-size:12px;
  line-height:1;
  font-weight:500;
  letter-spacing:3.6px;
  text-transform:uppercase;
  border:1px solid var(--ink);
  border-radius:var(--r-pill);
}
.btn-cta-shadow {
  background:var(--bronze);
  color:var(--cream);
  font-family:'EB Garamond',serif;
  font-size:14px;
  line-height:1;
  font-weight:500;
  border-radius:var(--r-12);
  box-shadow:var(--shadow-bronze);
}
.btn.is-pressed {
  transform:scale(.96);
  filter:brightness(.92);
}
.btn.is-disabled {
  opacity:.4;
  box-shadow:none;
  pointer-events:none;
}
/* cards */
.element-tile {
  position:relative;
  width:144px;
  height:144px;
  border-radius:var(--r-16);
  overflow:hidden;
  border:1px solid #8ba3b840;
  box-shadow:var(--shadow-card);
  padding:var(--sp-12);
}
.metal-tile {
  background:linear-gradient(135deg,#8ba3b810,#8ba3b840);
}
.element-tile .dm-icon {
  position:absolute;
  width:68px;
  height:68px;
  right:var(--sp-14);
  top:var(--sp-18);
  color:rgba(43,39,34,.78);
}
.polarity-chip {
  position:absolute;
  right:var(--sp-10);
  top:var(--sp-10);
  font-family:'EB Garamond',serif;
  font-size:10px;
  color:var(--inkSoft);
  background:var(--cardstock-bg);
  border:1px solid var(--paperHair);
  border-radius:var(--r-pill);
  padding:var(--sp-3) var(--sp-8);
}
.stem-label {
  position:absolute;
  left:var(--sp-12);
  bottom:var(--sp-12);
}
.stem-label strong {
  display:block;
  font-family:'Noto Serif SC',serif;
  font-size:26px;
  line-height:1;
  color:var(--inkDeep);
}
.stem-label span {
  font-family:'EB Garamond',serif;
  font-size:12px;
  color:var(--inkSoft);
}
.hero-card {
  position:relative;
  background:var(--silk);
  border:1px solid var(--paperHair);
  box-shadow:var(--shadow-card);
  overflow:hidden;
}
.section-hero {
  width:358px;
  height:340px;
  border-radius:var(--r-16);
}
.section-hero>img {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
}
.hero-shade {
  position:absolute;
  inset:0;
  background:linear-gradient(180deg,rgba(248,246,240,.12),rgba(248,246,240,.92));
}
.hero-content {
  position:absolute;
  inset:var(--sp-16);
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  z-index:1;
}
.hero-content h3 {
  font-family:'Cormorant Garamond',serif;
  font-size:32px;
  line-height:1.05;
  font-weight:600;
  margin:auto 0 var(--sp-6);
  color:var(--ink);
}
.subheadline {
  font-size:19px;
  line-height:1.3;
  font-weight:500;
  margin:0 0 var(--sp-14);
}
.segmented {
  display:inline-flex;
  align-items:center;
  gap:var(--sp-3);
  background:var(--tabbar-bg);
  border:1px solid var(--paperHair);
  border-radius:var(--r-pill);
  padding:var(--sp-3);
  backdrop-filter:blur(12px);
}
.segmented span {
  font-family:'EB Garamond',serif;
  font-size:12px;
  color:var(--inkSoft);
  padding:var(--sp-5) var(--sp-10);
  border-radius:var(--r-pill);
}
.segmented .active {
  background:var(--ink);
  color:var(--silk);
}
.segmented.mini {
  margin-bottom:var(--sp-16);
}
.modal-hero {
  width:358px;
  height:420px;
  border-radius:var(--r-16);
}
.modal-close {
  position:absolute;
  top:var(--sp-12);
  right:var(--sp-12);
  z-index:2;
  width:28px;
  height:28px;
  border-radius:var(--r-pill);
  border:1px solid var(--paperHair);
  background:var(--cardstock-bg);
  color:var(--ink);
  font-size:18px;
  line-height:1;
}
.modal-band {
  height:160px;
  overflow:hidden;
  border-bottom:1px solid var(--paperHair);
}
.modal-band img {
  width:100%;
  height:100%;
  object-fit:cover;
}
.modal-body {
  height:260px;
  overflow:auto;
  padding:var(--sp-18);
  background:var(--cardstock-bg);
}
.modal-body h3 {
  font-family:'Cormorant Garamond',serif;
  font-size:28px;
  line-height:1.1;
  font-weight:600;
  margin:var(--sp-12) 0 var(--sp-6);
}
.modal-body p:not(.subheadline) {
  font-size:14px;
  line-height:1.6;
  color:var(--inkSoft);
  margin:0;
}
.compact-strip, .daily-snippet {
  width:358px;
  height:96px;
  border-radius:var(--r-12);
  position:relative;
  overflow:hidden;
  display:grid;
  grid-template-columns:88px 1fr 22px;
  gap:var(--sp-12);
  align-items:center;
  padding:var(--sp-12);
  background:var(--cardstock-bg);
  border:1px solid var(--paperHair);
}
.compact-strip img, .daily-snippet img {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  opacity:.26;
}
.compact-strip div, .daily-snippet div, .compact-strip svg, .daily-snippet svg {
  position:relative;
  z-index:1;
}
.compact-strip h3, .daily-snippet h3 {
  font-family:'Cormorant Garamond',serif;
  font-size:20px;
  line-height:1.1;
  font-weight:600;
  margin:0 0 var(--sp-4);
}
.compact-strip p, .daily-snippet p {
  font-family:'EB Garamond',serif;
  font-size:12.5px;
  line-height:1.3;
  color:var(--inkSoft);
  margin:0;
}
.compact-strip svg, .daily-snippet svg {
  width:18px;
  height:18px;
  color:var(--bronzeDark);
}
.locked-card, .featured-card, .empty-card {
  width:358px;
  min-height:144px;
  border-radius:var(--r-12);
  padding:var(--sp-18);
  display:grid;
  gap:var(--sp-12);
}
.locked-card {
  grid-template-columns:36px 1fr auto;
  background:var(--quiet-bg);
  border:1px solid var(--quiet-border);
  align-items:center;
}
.locked-card svg {
  width:24px;
  height:24px;
  color:var(--bronzeDark);
}
.locked-card h3, .featured-card h3, .empty-card h3 {
  font-family:'Cormorant Garamond',serif;
  font-size:20px;
  line-height:1.2;
  font-weight:600;
  margin:0;
}
.locked-card p, .featured-card p, .empty-card p {
  font-family:'EB Garamond',serif;
  font-size:13.5px;
  line-height:1.5;
  color:var(--inkSoft);
  margin:var(--sp-4) 0 0;
}
.featured-card {
  background:#8ba3b810;
  border:1px solid #8ba3b840;
  box-shadow:var(--shadow-card);
}
.next-cue {
  font-family:'EB Garamond',serif;
  font-size:12px;
  letter-spacing:.5px;
  color:var(--bronzeDark);
}
.empty-card {
  align-items:center;
  justify-items:center;
  text-align:center;
  border:1px dashed var(--paperHair);
  background:rgba(248,241,225,.45);
  color:var(--inkLight);
}
.empty-card svg {
  width:56px;
  height:56px;
  opacity:.6;
}
.reading-row-card {
  width:720px;
  min-height:72px;
  border-radius:var(--r-12);
  background:var(--cardstock-bg);
  border:1px solid var(--paperHair);
  display:grid;
  grid-template-columns:44px 1fr 22px;
  gap:var(--sp-14);
  align-items:center;
  padding:var(--sp-14);
}
.read-icon {
  width:44px;
  height:44px;
  border-radius:var(--r-12);
  background:#8ba3b81A;
  border:1px solid #8ba3b840;
  display:grid;
  place-items:center;
  color:var(--metalDeep);
}
.read-icon svg {
  width:22px;
  height:22px;
}
.reading-row-card h3 {
  font-family:'Cormorant Garamond',serif;
  font-size:17px;
  line-height:1.2;
  font-weight:500;
  margin:0;
}
.reading-row-card p {
  font-family:'EB Garamond',serif;
  font-size:12.5px;
  line-height:1.3;
  color:var(--inkLight);
  margin:var(--sp-3) 0 0;
}
.reading-row-card .chev {
  width:18px;
  height:18px;
  color:var(--bronzeDark);
}
/* thumbnails */
.thumb-grid {
  display:grid;
  grid-template-columns:repeat(3, minmax(0,1fr));
  gap:var(--sp-18);
}
.thumb {
  position:relative;
  width:200px;
  height:200px;
  border-radius:var(--r-16);
  overflow:hidden;
  border:1px solid var(--paperHair);
  background:var(--silk);
  display:grid;
  place-items:center;
}
.thumb img {
  width:100%;
  height:100%;
  object-fit:cover;
}
.square-element {
  background:linear-gradient(135deg,#8ba3b810,#8ba3b840);
  color:var(--metalDeep);
}
.square-element svg, .gradient-thumb svg {
  width:56px;
  height:56px;
}
.square-element span {
  position:absolute;
  left:var(--sp-14);
  bottom:var(--sp-14);
  font-family:'Noto Serif SC',serif;
  font-size:30px;
  color:var(--inkDeep);
}
.overlay-thumb img {
  position:absolute;
  inset:0;
}
.overlay-thumb::after {
  content:"";
  position:absolute;
  inset:0;
  background:rgba(43,39,34,.50);
}
.overlay-thumb span {
  position:relative;
  z-index:1;
  font-family:'Cormorant Garamond',serif;
  font-size:24px;
  color:var(--silk);
}
.gradient-thumb {
  background:linear-gradient(180deg,#8ba3b810,#8ba3b840);
  color:var(--metalDeep);
}
.locked-thumb img {
  filter:blur(3px);
  opacity:.55;
}
.locked-thumb span {
  position:absolute;
  top:var(--sp-12);
  right:var(--sp-12);
  background:var(--gold);
  border-radius:var(--r-pill);
  padding:var(--sp-4) var(--sp-8);
  font-family:'EB Garamond',serif;
  font-size:9px;
  letter-spacing:2px;
  color:var(--ink);
}
/* forms */
.input-grid {
  display:grid;
  gap:var(--sp-12);
}
.field {
  display:grid;
  gap:var(--sp-5);
}
.field span {
  font-family:'EB Garamond',serif;
  font-size:10px;
  letter-spacing:2.5px;
  text-transform:uppercase;
  color:var(--bronzeDark);
}
.field input {
  width:320px;
  min-height:44px;
  border:1px solid var(--paperHair);
  border-radius:var(--r-12);
  background:var(--cardstock-bg);
  color:var(--ink);
  padding:0 var(--sp-14);
  font-family:'EB Garamond',serif;
  font-size:15px;
}
.field.is-focus input {
  border:2px solid var(--borderFocus);
}
.field.is-error input {
  border:2px solid var(--seal);
}
.field small {
  font-family:'EB Garamond',serif;
  font-size:12px;
  color:var(--seal);
}
.toggle-row {
  display:flex;
  gap:var(--sp-14);
  align-items:center;
}
.toggle {
  width:44px;
  height:22px;
  border-radius:var(--r-22);
  border:1px solid var(--paperHair);
  background:var(--cardstock-bg);
  padding:var(--sp-3);
  display:flex;
  align-items:center;
}
.toggle i {
  width:16px;
  height:16px;
  border-radius:var(--r-pill);
  background:var(--silk);
  border:1px solid var(--paperHair);
  display:block;
}
.toggle.is-on {
  background:var(--bronze);
  border-color:var(--bronze);
  justify-content:flex-end;
}
.radio-group {
  display:flex;
  gap:var(--sp-16);
  align-items:center;
}
.radio-group label {
  font-family:'EB Garamond',serif;
  font-size:14px;
  color:var(--inkSoft);
}
.radio-group input {
  accent-color:var(--bronze);
}
.segmented.large span {
  font-size:14px;
  padding:var(--sp-8) var(--sp-16);
}
.search-bar {
  width:358px;
  min-height:44px;
  border:1px solid var(--paperHair);
  border-radius:var(--r-pill);
  background:var(--cardstock-bg);
  display:flex;
  align-items:center;
  gap:var(--sp-10);
  padding:0 var(--sp-14);
}
.search-bar svg {
  width:18px;
  height:18px;
  color:var(--inkLight);
}
.search-bar input {
  flex:1;
  border:0;
  outline:0;
  background:transparent;
  font-family:'EB Garamond',serif;
  font-size:15px;
  color:var(--ink);
}
.search-bar input::placeholder {
  color:var(--inkLight);
}
/* chrome */
.chrome-board {
  display:grid;
  gap:var(--sp-14);
  background:var(--cardstock-bg);
  border:1px solid var(--paperHair);
  border-radius:var(--r-16);
  padding:var(--sp-18);
}
.chrome-row {
  display:flex;
  gap:var(--sp-10);
  align-items:center;
  flex-wrap:wrap;
}
.eyebrow-chip {
  min-height:22px;
  display:inline-flex;
  align-items:center;
  padding:0 var(--sp-8);
  font-family:'EB Garamond',serif;
  font-size:9px;
  line-height:1.6;
  font-weight:500;
  letter-spacing:1.6px;
  border:1px solid var(--paperHair);
  border-radius:var(--r-pill);
  background:var(--cream);
  color:var(--bronzeDark);
}
.status-badge, .tag-pill, .lock-chip, .tier-badge {
  display:inline-flex;
  align-items:center;
  min-height:22px;
  border-radius:var(--r-pill);
  padding:0 var(--sp-8);
  border:1px solid var(--paperHair);
}
.status-badge {
  font-family:'Cinzel',serif;
  font-size:10px;
  line-height:1;
  font-weight:500;
  letter-spacing:2px;
}
.status-badge.live {
  color:var(--woodDeep);
  background:#7a9e6e1A;
  border-color:#7a9e6e40;
}
.status-badge.beta {
  color:var(--waterDeep);
  background:#5a7fa81A;
  border-color:#5a7fa840;
}
.status-badge.locked {
  color:var(--bronzeDark);
  background:var(--quiet-bg);
  border-color:var(--quiet-border);
}
.tag-pill {
  font-family:'EB Garamond',serif;
  font-size:11px;
  color:var(--inkSoft);
}
.tag-pill.metal {
  background:#8ba3b81A;
  border-color:#8ba3b840;
}
.tag-pill.wood {
  background:#7a9e6e1A;
  border-color:#7a9e6e40;
}
.tag-pill.fire {
  background:#c4745a1A;
  border-color:#c4745a40;
}
.lock-chip {
  background:var(--gold);
  border-color:var(--gold);
  font-family:'EB Garamond',serif;
  font-size:9px;
  line-height:1;
  letter-spacing:2px;
  color:var(--ink);
}
.tier-badge {
  font-family:'EB Garamond',serif;
  font-size:12px;
  color:var(--bronzeDark);
  background:var(--cardstock-bg);
}
.tier-badge.seeker {
  color:var(--bronzeDark);
  border-color:var(--gold);
}
.tier-badge.advisor {
  color:var(--advisor);
  border-color:var(--advisor);
}
.tier-badge.free {
  color:var(--bronzeDark);
  border-color:var(--bronzeDark);
}
.log-table {
  width:100%;
  border-collapse:collapse;
  background:var(--cardstock-bg);
  border:1px solid var(--paperHair);
  border-radius:var(--r-16);
  overflow:hidden;
}
.log-table th, .log-table td {
  border-bottom:1px solid var(--paperHair);
  padding:var(--sp-12) var(--sp-14);
  text-align:left;
  font-family:'EB Garamond',serif;
  font-size:13.5px;
  color:var(--inkSoft);
  vertical-align:top;
}
.log-table th {
  font-size:10px;
  letter-spacing:2.5px;
  text-transform:uppercase;
  color:var(--bronzeDark);
  font-weight:500;
}
.log-table tr:last-child td {
  border-bottom:0;
}

</style>
</head>
<body>
<!-- Embedded icons.svg for standalone preview -->
<!--
  ============================================================
  Elementum · Icon Library (canonical source-of-truth)
  ============================================================

  Single SVG file containing every reusable icon as a <symbol>.
  Consumed by every legend HTML and by the React app via inline
  <svg><use href="icons.svg#id"/></svg> references.

  Convention:
    · viewBox 0 0 24 24
    · stroke="currentColor" — colour controlled by parent CSS
    · stroke-width 1.7 unless noted
    · stroke-linecap="round" stroke-linejoin="round"
    · fill="none" unless explicitly filled

  ID prefixes:
    el-*    five elements (5)
    dm-*    ten day-master stems (10) — PLACEHOLDER, needs ink-wash commission
    tab-*   bottom tab navigation (5)
    read-*  reading-section catalogue (5) — PLACEHOLDER, refinement welcome
    ico-*   utility / chrome (8)

  Total: 33 symbols.

  Sealed against:
    · legend-primitives.html §7
    · legend-screens.html §4 (canonical tab paths)
    · legend-screens-amendment.html §A2/§A3/§A6 (placeholders DA.2 + DA.9)

  When editing: add/edit symbol here ONLY. Never duplicate inline.
  Drift between this file and any inline SVG in a legend is a
  doc-patch trigger.
  ============================================================
-->
<svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>

    <!-- ============================================================
         FIVE ELEMENTS · el-*
         Source: legend-primitives.html §7 (lines 963–987)
         Unchanged across v1/v2/v3.
         ============================================================ -->

    <symbol id="el-metal" viewBox="0 0 24 24">
      <path d="M5.28 12.6 A7.68 7.68 0 0 1 18.72 12.6"
            stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none"/>
    </symbol>

    <symbol id="el-wood" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none">
        <line x1="12" y1="19.2" x2="12" y2="4.8"/>
        <line x1="12" y1="10.8" x2="6.72" y2="6"/>
        <line x1="12" y1="10.8" x2="17.28" y2="6"/>
      </g>
    </symbol>

    <symbol id="el-fire" viewBox="0 0 24 24">
      <path d="M12 4.8 L18.24 17.28 L5.76 17.28 Z"
            stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" fill="none"/>
    </symbol>

    <symbol id="el-earth" viewBox="0 0 24 24">
      <rect x="5.76" y="6.72" width="12.48" height="10.56"
            stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" fill="none" rx="0.96"/>
    </symbol>

    <symbol id="el-water" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" fill="none">
        <path d="M4.8 10.08 Q 9.6 7.2 12 10.08 T 19.2 10.08"/>
        <path d="M4.8 15.36 Q 9.6 12.48 12 15.36 T 19.2 15.36"/>
      </g>
    </symbol>


    <!-- ============================================================
         TEN DAY-MASTER STEMS · dm-*
         Source: legend-screens-amendment.html §A3
         Status: PLACEHOLDER (DA.2) — ink-wash brushwork to commission.
         Each pairs with a stem hanzi rendered separately in
         Noto Serif SC (NOT included in these symbols).
         ============================================================ -->

    <!-- 甲 jiǎ · Yang Wood · standing tree -->
    <symbol id="dm-jia" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round">
        <path d="M12 4 V20"/>
        <path d="M12 8 H6"/><path d="M12 8 H18"/>
        <path d="M12 13 H8"/><path d="M12 13 H16"/>
      </g>
    </symbol>

    <!-- 乙 yǐ · Yin Wood · vine -->
    <symbol id="dm-yi" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round">
        <path d="M5 18 Q 9 14 12 16 T 19 12"/>
        <path d="M14 17 Q 16 18 17 20"/>
      </g>
    </symbol>

    <!-- 丙 bǐng · Yang Fire · sun -->
    <symbol id="dm-bing" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round">
        <circle cx="12" cy="12" r="4"/>
        <line x1="12" y1="3"   x2="12"   y2="5.5"/>
        <line x1="12" y1="18.5" x2="12"  y2="21"/>
        <line x1="3"  y1="12"  x2="5.5"  y2="12"/>
        <line x1="18.5" y1="12" x2="21" y2="12"/>
        <line x1="5.5" y1="5.5" x2="7.3" y2="7.3"/>
        <line x1="16.7" y1="16.7" x2="18.5" y2="18.5"/>
        <line x1="5.5" y1="18.5" x2="7.3" y2="16.7"/>
        <line x1="16.7" y1="7.3" x2="18.5" y2="5.5"/>
      </g>
    </symbol>

    <!-- 丁 dīng · Yin Fire · candle -->
    <symbol id="dm-ding" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="11" width="6" height="9"/>
        <path d="M11 6 Q 12 4 13 6 Q 13 9 12 11 Q 11 9 11 6 Z"/>
      </g>
    </symbol>

    <!-- 戊 wù · Yang Earth · mountain peaks -->
    <symbol id="dm-wu" viewBox="0 0 24 24">
      <path d="M3 19 L 8 8 L 12 14 L 16 6 L 21 19 Z"
            stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round"/>
    </symbol>

    <!-- 己 jǐ · Yin Earth · tilled field -->
    <symbol id="dm-ji" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round">
        <rect x="4" y="6" width="16" height="12"/>
        <line x1="4" y1="12" x2="20" y2="12"/>
        <line x1="12" y1="6" x2="12" y2="18"/>
      </g>
    </symbol>

    <!-- 庚 gēng · Yang Metal · blade -->
    <symbol id="dm-geng" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 19 L 19 5"/>
        <path d="M3 19 L 9 19"/>
        <path d="M5 19 L 5 13"/>
      </g>
    </symbol>

    <!-- 辛 xīn · Yin Metal · jewel -->
    <symbol id="dm-xin" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linejoin="round">
        <path d="M12 4 L 18 9 L 15 19 L 9 19 L 6 9 Z"/>
        <line x1="12" y1="4" x2="12" y2="19"/>
        <line x1="6" y1="9" x2="18" y2="9"/>
      </g>
    </symbol>

    <!-- 壬 rén · Yang Water · river -->
    <symbol id="dm-ren" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round">
        <path d="M3 10 Q 7 6 11 10 T 19 10"/>
        <path d="M3 14 Q 7 10 11 14 T 19 14"/>
      </g>
    </symbol>

    <!-- 癸 guǐ · Yin Water · mist -->
    <symbol id="dm-gui" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round">
        <path d="M4 7 Q 7 5 10 7"/>
        <path d="M14 8 Q 17 6 20 8"/>
        <path d="M5 12 Q 8 10 11 12 T 19 12"/>
        <path d="M8 17 Q 11 15 14 17"/>
      </g>
    </symbol>


    <!-- ============================================================
         BOTTOM TAB NAV · tab-*
         Source: legend-screens.html §4 (lines 1227–1231 canonical)
         Status: SEALED — do not redraw without doc patch.
         ============================================================ -->

    <symbol id="tab-today" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="16" rx="2"/>
        <path d="M3 10h18"/>
        <path d="M8 3v4"/>
        <path d="M16 3v4"/>
      </g>
    </symbol>

    <symbol id="tab-guidance" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"/>
        <path d="M12 4.8 L14.5 12 L12 19.2 L9.5 12 Z"/>
        <circle cx="12" cy="12" r="0.9" fill="currentColor" stroke="none"/>
      </g>
    </symbol>

    <symbol id="tab-reading" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 5 C 6 4, 9 4, 12 6 C 15 4, 18 4, 21 5 V19 C 18 18, 15 18, 12 20 C 9 18, 6 18, 3 19 Z"/>
        <path d="M12 6 V20"/>
      </g>
    </symbol>

    <symbol id="tab-compat" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="8.5" cy="12" r="6.5"/>
        <circle cx="15.5" cy="12" r="6.5"/>
        <circle cx="12" cy="12" r="0.9" fill="currentColor" stroke="none"/>
      </g>
    </symbol>

    <symbol id="tab-profile" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="8" r="4"/>
        <path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"/>
      </g>
    </symbol>


    <!-- ============================================================
         READING-SECTION CATALOGUE · read-*
         Source: legend-screens-amendment.html §A2 / §A6
         Status: PLACEHOLDER (DA.9) — refinement or brushwork welcome.
         ============================================================ -->

    <!-- Elemental Nature — wu-xing pentagram -->
    <symbol id="read-elemental" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="8"/>
        <path d="M12 4 L 19.6 9.4 L 16.7 18.6 L 7.3 18.6 L 4.4 9.4 Z"/>
      </g>
    </symbol>

    <!-- Dominant Energies — primary filled + secondary hollow -->
    <symbol id="read-dominant" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.6" fill="none">
        <circle cx="9" cy="11" r="4" fill="currentColor"/>
        <circle cx="17" cy="15" r="2.5"/>
      </g>
    </symbol>

    <!-- Forces in Motion — ↑↓ paired arrows -->
    <symbol id="read-forces" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 4 V14 M5 7 L 8 4 L 11 7"/>
        <path d="M16 20 V10 M13 17 L 16 20 L 19 17"/>
      </g>
    </symbol>

    <!-- Life Chapters — vertical stem + 3 horizontal branches (decade timeline) -->
    <symbol id="read-chapters" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round">
        <line x1="12" y1="3"  x2="12" y2="21"/>
        <line x1="9"  y1="7"  x2="15" y2="7"/>
        <line x1="9"  y1="12" x2="15" y2="12"/>
        <line x1="9"  y1="17" x2="15" y2="17"/>
      </g>
    </symbol>

    <!-- Pillar Patterns — 4 vertical bars (the literal 八字 four pillars) -->
    <symbol id="read-pillars" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round">
        <line x1="5"    y1="6" x2="5"    y2="18"/>
        <line x1="9.7"  y1="6" x2="9.7"  y2="18"/>
        <line x1="14.3" y1="6" x2="14.3" y2="18"/>
        <line x1="19"   y1="6" x2="19"   y2="18"/>
      </g>
    </symbol>


    <!-- ============================================================
         UTILITY / CHROME · ico-*
         Source: legend-primitives.html §7 (lock) + amendment + DOC5.
         ============================================================ -->

    <!-- Lock — locked card affordance -->
    <symbol id="ico-lock" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round">
        <rect x="5" y="11" width="14" height="9" rx="1.5"/>
        <path d="M8 11 V 8 a4 4 0 0 1 8 0 V 11"/>
      </g>
    </symbol>

    <!-- Chevron right — list-row affordance -->
    <symbol id="ico-chev-r" viewBox="0 0 24 24">
      <path d="M9 6 L15 12 L9 18"
            stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>

    <!-- Chevron left — back affordance -->
    <symbol id="ico-chev-l" viewBox="0 0 24 24">
      <path d="M15 6 L9 12 L15 18"
            stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>

    <!-- Arrow right — CTA / dashed-link affordance -->
    <symbol id="ico-arrow-r" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12 H19"/>
        <path d="M14 7 L19 12 L14 17"/>
      </g>
    </symbol>

    <!-- Dismiss × — modal close -->
    <symbol id="ico-dismiss" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round">
        <line x1="6" y1="6"  x2="18" y2="18"/>
        <line x1="18" y1="6" x2="6"  y2="18"/>
      </g>
    </symbol>

    <!-- Sun + horizon — daily / Today affordance -->
    <symbol id="ico-sunrise" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round">
        <line x1="3" y1="17" x2="21" y2="17"/>
        <path d="M7 17 A 5 5 0 0 1 17 17"/>
        <line x1="12" y1="6"  x2="12"  y2="8"   stroke-width="1.4"/>
        <line x1="6"  y1="11" x2="7.3" y2="12.3" stroke-width="1.4"/>
        <line x1="18" y1="11" x2="16.7" y2="12.3" stroke-width="1.4"/>
      </g>
    </symbol>

    <!-- Empty placeholder — circle + 3-dot ellipsis (vessel-not-yet-filled) -->
    <symbol id="ico-empty" viewBox="0 0 24 24">
      <g stroke="currentColor" stroke-width="1.4" fill="none">
        <circle cx="12" cy="12" r="7"/>
        <circle cx="9"  cy="12" r="0.9" fill="currentColor" stroke="none"/>
        <circle cx="12" cy="12" r="0.9" fill="currentColor" stroke="none"/>
        <circle cx="15" cy="12" r="0.9" fill="currentColor" stroke="none"/>
      </g>
    </symbol>

    <!-- Edit pencil — Profile edit action -->
    <symbol id="ico-edit" viewBox="0 0 24 24">
      <path d="M14.5 4.5l5 5L8 21H3v-5L14.5 4.5z"
            stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>

  </defs>
</svg>


