  <section id="C1">
    <div class="section-head"><div class="num">§C1</div><div><h2>Text blocks</h2><div class="rule">Ten typography recipes, rendered live with copy-paste HTML/CSS annotations.</div></div></div>
    
    <article class="component-row">
      <div class="component-live">
        <div class="component-kicker">01 · Hero pair</div>
        <div class="tb tb-hero">
  <h3>The Blade</h3>
