  <section id="C2">
    <div class="section-head"><div class="num">§C2</div><div><h2>Buttons</h2><div class="rule">Five variants across default, pressed, and disabled states.</div></div></div>
    <div class="button-grid">
      
        <article class="button-cell">
          <div class="component-kicker">Default · Primary</div>
          <button class="btn btn-primary ">Begin reading</button>
          <pre><code>&lt;button class=&quot;btn btn-primary &quot;&gt;Begin reading&lt;/button&gt;
.btn-primary { background: var(--ink); color: var(--silk); font: 500 12px/1 &#x27;Cinzel&#x27;; letter-spacing: 3.6px; text-transform: uppercase; border-radius: var(--r-pill); box-shadow: var(--shadow-cta); }
.is-pressed { transform: scale(0.96); }
.is-disabled { opacity: .4; box-shadow: none; pointer-events: none; }</code></pre>
        </article>
        <article class="button-cell">
          <div class="component-kicker">Default · Secondary</div>
          <button class="btn btn-secondary ">View details</button>
          <pre><code>&lt;button class=&quot;btn btn-secondary &quot;&gt;View details&lt;/button&gt;
.btn-secondary { background: var(--cardstock-bg); color: var(--ink); font: 500 12px/1 &#x27;Cinzel&#x27;; letter-spacing: 3.6px; text-transform: uppercase; border: 1px solid var(--paperHair); border-radius: var(--r-pill); }
.is-pressed { transform: scale(0.96); }
.is-disabled { opacity: .4; box-shadow: none; pointer-events: none; }</code></pre>
        </article>
        <article class="button-cell">
