.btn-primary { background: var(--ink); color: var(--silk); font: 500 12px/1 &#x27;Cinzel&#x27;; letter-spacing: 3.6px; text-transform: uppercase; border-radius: var(--r-pill); box-shadow: var(--shadow-cta); }
